{
    "rewrites": [
        {
            "source": "/html-compiler",
            "destination": "/compiler.html"
        },
        {
            "source": "/python-compiler",
            "destination": "/compiler.html"
        },
        {
            "source": "/blog/:slug",
            "destination": "/blog-post.html"
        },
        {
            "source": "/blog/*",
            "destination": "/blog-post.html"
        }
    ]
}